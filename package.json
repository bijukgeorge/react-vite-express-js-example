{
  "name": "react-vite-express-js-example",
  "version": "1.0.0",
  "description": "Full-stack React + Vite + Express.js application",
  "private": true,
  "scripts": {
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run start",
    "dev:frontend": "cd frontend && npm run dev",
    "build:shared": "cd shared && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../shared && npm install",
    "format:all": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:all:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean:all": "rm -rf frontend/dist backend/node_modules frontend/node_modules shared/node_modules shared/dist node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
